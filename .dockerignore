# Exclude Git metadata history files
.git
.github/
.gitignore

# Exclude Virtual Environment
.venv/

# Ignore all .env files
.env
.env.*

# Exclude Python Cache 
__pycache__/
*.py[cod]

# Exclude  Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.coverage.*

# Exclude Jupyter
.ipynb_checkpoints/
notebooks/

# Exclude IDE & OS Settings
.vscode/
Thumbs.db
.DS_Store
.idea/

# Exclude Log files
logs/
*.log

# Exclude Documentation & Tests
tests/
README.md